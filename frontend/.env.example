# Veritas web app — environment
# Copy to `.env.local` and fill in. Only VITE_-prefixed values reach the browser.

# ── The Veritas API ───────────────────────────────────────────────────────────
# Leave VITE_API_URL empty to call the API on the app's own origin: in development the
# Vite dev server forwards /v1 and /health to VERITAS_API_PROXY (default
# http://localhost:8000), and in production nginx.conf does the same. Set VITE_API_URL
# only when the API is on another origin (no trailing slash), and allow that origin in
# the backend's VERITAS_CORS_ORIGINS.
VITE_API_URL=
VERITAS_API_PROXY=http://localhost:8000

# ── Continue with Google (Firebase) ────────────────────────────────────────────
# Only for the "Continue with Google" button: email and password accounts do not need it,
# the Veritas API checks those itself. Left empty, the button is not shown. To turn it on,
# create a Firebase project, enable the Google provider (Authentication → Sign-in method),
# add a web app and copy its config here, and give the backend the same project id as
# VERITAS_FIREBASE_PROJECT_ID. These values name the project and grant nothing by
# themselves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
