# Copy to .env (in backend/) and adjust. Every line can also be set as an
# environment variable; the environment wins over this file. Empty means unset.

VERITAS_ENV=dev
VERITAS_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/veritas_dev

# Private files: KYB documents now, evidence originals later. Keep it out of git.
VERITAS_STORAGE_DIR=data/storage

# Keys the HMAC that login codes are stored under. Required in production,
# 32 characters or more. Make one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
VERITAS_SECRET_KEY=

# Writes login codes to the log so you can log in before SMS exists.
# The app refuses to start with this on when VERITAS_ENV=prod.
VERITAS_OTP_ECHO=true

VERITAS_OTP_TTL_SECONDS=300
VERITAS_OTP_MAX_ATTEMPTS=5
VERITAS_OTP_REQUESTS_PER_HOUR=5
VERITAS_SESSION_TTL_DAYS=30
VERITAS_KEY_CHALLENGE_TTL_SECONDS=600

# The web app's accounts: an email and a password, checked by the API. After this many
# wrong passwords in a row, password logins to the account stop for the lock time.
VERITAS_PASSWORD_MAX_FAILURES=10
VERITAS_PASSWORD_LOCK_MINUTES=15
# Links to set a new password: how long one works, how many an account gets in an hour,
# and where the web app is, which the links point to.
VERITAS_PASSWORD_RESET_TTL_MINUTES=30
VERITAS_PASSWORD_RESETS_PER_HOUR=5
VERITAS_WEB_APP_URL=http://localhost:8080

# Email, for those links. Through an SMTP server: 587 upgrades with STARTTLS, 465 is TLS
# from the start. Without one nothing is sent; VERITAS_MAIL_ECHO writes each email to the
# log instead, so you can follow its link. The app refuses to start with it when
# VERITAS_ENV=prod.
# VERITAS_SMTP_HOST=smtp.example.com
# VERITAS_SMTP_PORT=587
# VERITAS_SMTP_STARTTLS=true
# VERITAS_SMTP_USERNAME=
# VERITAS_SMTP_PASSWORD=
# VERITAS_MAIL_FROM=Veritas <no-reply@veritas.example.az>
VERITAS_MAIL_ECHO=true

# "Continue with Google" in the web app goes through Firebase, and the web app trades the
# Firebase ID token for a session at POST /v1/auth/firebase. The project id is the one in
# the web app's VITE_FIREBASE_PROJECT_ID. Unset: Google sign-in is refused; email and
# password accounts work without it.
# VERITAS_FIREBASE_PROJECT_ID=
# Origins allowed to call the API from a browser (a JSON list), only when the web app is
# served from another origin than the API. The dev server and nginx pass /v1 through.
# VERITAS_CORS_ORIGINS=["https://veritas.example.az"]
# The web app's "Demo donor" and "Demo organisation" buttons: anyone can sign in as those
# two accounts without a password, so only on a demo server. Off: the buttons say so.
VERITAS_DEMO_LOGIN=true
VERITAS_MAX_UPLOAD_BYTES=20971520

# Only for the test suite: a server's `postgres` database, as a user that can create
# databases and the PostGIS extension. Read from the environment, not from this file.
# VERITAS_TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/postgres

# The chain. Without both, the API runs without one and Passports never launch.
# VERITAS_CHAIN_RPC_URL=http://127.0.0.1:8545
# VERITAS_DEPLOYMENT_FILE=../contracts/deployments/31337.json
# Empty: final means the node's "finalized" block. A number: that many blocks deep.
# VERITAS_CHAIN_CONFIRMATIONS=
# The relayer's key; a cloud KMS in production. The admin key only on Anvil and the demo.
# VERITAS_RELAYER_KEY=
# VERITAS_ADMIN_KEY=
VERITAS_RELAYER_MIN_PRIORITY_FEE_GWEI=30

# The card provider and the bank. In development both are veritas.mocks.app.
VERITAS_PSP_BASE_URL=http://127.0.0.1:8100
VERITAS_PSP_API_KEY=psp-development-key
VERITAS_PSP_WEBHOOK_SECRET=whsec-development-secret
VERITAS_PSP_WEBHOOK_URL=http://127.0.0.1:8000/v1/webhooks/psp
VERITAS_BANK_BASE_URL=http://127.0.0.1:8100
VERITAS_BANK_API_KEY=bank-development-key
# MockBank signs with this key; its address must be the bank key the hub was deployed with.
# VERITAS_MOCKBANK_KEY=
# IBANs MockBank treats as closed, to try a failed payout (a JSON list).
# VERITAS_MOCKBANK_CLOSED_ACCOUNTS=[]

# Evidence. How long a challenge code is valid, how late uploads may arrive, how far a
# phone's clock may be off, the least precise GPS fix that can place a capture on the site,
# and how close two photos' pHash and dHash must be (bits of 64) to count as the same photo
# (a hard fail) or as close (an advisory).
VERITAS_CAPTURE_SESSION_MINUTES=15
VERITAS_EVIDENCE_UPLOAD_GRACE_MINUTES=60
VERITAS_EVIDENCE_CLOCK_SKEW_SECONDS=120
VERITAS_EVIDENCE_MAX_ACCURACY_M=50
VERITAS_PHOTO_REUSE_CLEAR_BITS=6
VERITAS_PHOTO_REUSE_CLOSE_BITS=12
# App attestation: "dev" (an HMAC the development build makes with the secret below) or
# "platform" (App Attest and Play Integrity, not built yet, so every bundle fails check 1).
# Unset: dev outside production, platform in it. Production refuses dev.
# VERITAS_ATTESTATION=
VERITAS_ATTESTATION_DEV_SECRET=veritas-development-attestation
# Kubo's RPC API (not a gateway). Public copies of evidence are added and pinned there.
VERITAS_IPFS_API_URL=http://127.0.0.1:5001
# Keep public copies in memory instead, when no Kubo node runs. Production refuses it.
VERITAS_IPFS_FAKE=false
VERITAS_IPFS_TIMEOUT_SECONDS=30
# A folder with OpenCV's Haar cascade files, for OpenCV builds that do not bundle them.
# Without a face and number plate detector, no photo is published.
# VERITAS_REDACTION_CASCADE_DIR=

# The assistant on the website (veritas.assistant): an OpenAI model that answers questions
# about Veritas. Without a key it is off and says so. The key stays on the server; put the
# real one in .env only. OPENAI_API_KEY works too.
# VERITAS_OPENAI_API_KEY=
VERITAS_OPENAI_MODEL=gpt-4.1-mini
VERITAS_OPENAI_BASE_URL=https://api.openai.com/v1
# Only for reasoning models, for example minimal with gpt-5-mini.
# VERITAS_OPENAI_REASONING_EFFORT=
VERITAS_OPENAI_TIMEOUT_SECONDS=15
VERITAS_ASSISTANT_MAX_OUTPUT_TOKENS=600
# Questions one visitor (IP address) may ask a minute and a day, and model calls a day for
# everyone together per API process. Behind nginx run uvicorn with --proxy-headers.
VERITAS_ASSISTANT_PER_MINUTE=6
VERITAS_ASSISTANT_PER_DAY=60
VERITAS_ASSISTANT_DAILY_BUDGET=2000
