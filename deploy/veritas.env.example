# The API's settings in Docker. Copy to deploy/veritas.env (or run `make env`) and fill in.
# Never commit deploy/veritas.env. Every setting is explained in backend/.env.example.
# The database URL and the storage folder are set by docker-compose.yml.

# "dev" runs without a blockchain; "prod" refuses to start without one.
VERITAS_ENV=dev

# 32 characters or more. `make env` puts a random one here.
VERITAS_SECRET_KEY=

# Where the site is, for the links in emails.
VERITAS_WEB_APP_URL=http://127.0.0.1:8110

# The "Demo donor" and "Demo organisation" buttons, with no password. Demo servers only.
VERITAS_DEMO_LOGIN=true

# No SMS or SMTP on the demo: login codes are off, reset-password emails go to the log.
VERITAS_OTP_ECHO=false
VERITAS_MAIL_ECHO=true

# "Continue with Google": the Firebase project id, the same as VITE_FIREBASE_PROJECT_ID in
# frontend/.env.local. Empty: Google sign-in is refused, email and password still work.
VERITAS_FIREBASE_PROJECT_ID=

# The assistant in the corner. Empty: it says it is off.
VERITAS_OPENAI_API_KEY=
VERITAS_OPENAI_MODEL=gpt-4.1-mini

# Public evidence copies in memory, as no IPFS node runs on the demo.
VERITAS_IPFS_FAKE=true
VERITAS_MAX_UPLOAD_BYTES=20971520

# uvicorn processes for the API.
API_WORKERS=2
